# Chave da OpenAI / OpenAI API key
OPENAI_API_KEY=sk-...

# Modelo usado pelo agente / Model used by the agent
OPENAI_MODEL=gpt-4o-mini

# Opcional: fixa "agora" no fuso da loja (os pedidos de exemplo vão até mar/2026).
# Optional: pins "now" in the store timezone (sample orders end in Mar/2026).
# EMPORIO_AGORA=2026-03-20T10:30
